[
  {
    "label": "Debug Go: tests in current folder",
    "adapter": "Delve",
    "request": "launch",
    "mode": "test",
    "program": "$ZED_DIRNAME",
    "cwd": "$ZED_DIRNAME",
    "args": ["-test.v", "-test.timeout=0"]
  },
  {
    "label": "Debug Go: test at cursor (Test function)",
    "adapter": "Delve",
    "request": "launch",
    "mode": "test",
    "program": "$ZED_DIRNAME",
    "cwd": "$ZED_DIRNAME",
    "args": ["-test.run", "^${ZED_SYMBOL}$", "-test.v", "-test.timeout=0"]
  },
  {
    "label": "Debug Vitest: current file",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/node_modules/vitest/vitest.mjs",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [
      "run",
      "$ZED_FILE",
      "--no-file-parallelism",
      "--test-timeout=0"
    ],
    "autoAttachChildProcesses": true,
    "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
    "console": "integratedTerminal"
  },
  {
    "label": "Debug Vitest: test at cursor (it/test line)",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/node_modules/vitest/vitest.mjs",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [
      "run",
      "$ZED_FILE:$ZED_ROW",
      "--no-file-parallelism",
      "--test-timeout=0"
    ],
    "autoAttachChildProcesses": true,
    "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
    "console": "integratedTerminal"
  }
]
