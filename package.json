{
  "name": "programming-fundamentals",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest --watch",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src vitest.config.ts",
    "fmt": "oxfmt --write src vitest.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "fmt:check": "oxfmt --check src vitest.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24 <25 || >=26"
  },
  "packageManager": "pnpm@12.9.1"
}
